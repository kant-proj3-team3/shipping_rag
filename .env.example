# 복사해서 .env 로 쓴다 (.env 는 커밋 금지). 값이 없는 항목은 직접 채운다.
# 아래 이름은 권장안이다. 모듈 담당자가 다르게 정하면 이 파일과 CLAUDE.md 를 함께 고친다.

# --- 외부 서비스 (compose 안에서는 api·cli 가 서비스 이름 주소로 덮어쓴다) ---
QDRANT_URL=http://localhost:6333
# QDRANT_PATH=./.qdrant_local        # 서버 없이 단독 개발할 때만 (한 번에 한 프로세스)
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag   # 세션 이력 원본(PostgreSQL). compose 의 postgres 기본 계정과 같다
# POSTGRES_USER=rag                  # compose 의 postgres 계정(바꾸면 DATABASE_URL 도 같이 바꾼다)
# POSTGRES_PASSWORD=rag
# POSTGRES_DB=rag

# --- LLM ---
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna

# --- Langfuse (Cloud) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- 구현 선택 ---
# app(api·cli)은 기본으로 실제 구현(청킹·검색·백엔드)으로 조립된다. 목업으로 돌리려면 APP_IMPL=mock (키·DB·모델 없이 돈다).
# 모듈 하나만 바꾸려면 아래 모듈별 값을 직접 준다(모듈별 값이 APP_IMPL 보다 우선). 모듈 단위 테스트·CI 는 이 값 없이 목업으로 돈다.
# APP_IMPL=real
# CHUNKING_IMPL=real                 # PDF 구조 청킹·E5 임베딩·Qdrant 색인
# RETRIEVAL_IMPL=real                # Qdrant 하이브리드 검색
# BACKEND_IMPL=real                  # 실제 QA 서비스(OPENAI_API_KEY 필요, 없으면 /query 만 model_failed)와 PostgreSQL+Redis 세션, 답변 평가기
# CACHE_ENABLED=false                # 답변 캐시(Redis)를 끈다. 기본은 켜짐. 평가를 돌릴 때는 꺼야 한다(적중한 응답은 모델을 부르지 않아 시간·토큰 지표를 왜곡한다)

# --- 답변 평가 (BACKEND_IMPL=real 일 때의 평가기. 기본값이면 아래는 비워 둬도 된다) ---
# EVAL_MODEL=gpt-6-luna              # RAGAS·Judge 평가 모델
# EVAL_MAX_CONCURRENCY=4             # 동시에 평가하는 문항 수
# EVAL_RAGAS_EXTRA=answer_relevancy  # 선택 지표(쉼표 구분: answer_relevancy, context_recall, context_precision). 호출이 늘어난다

# --- RAG ---
INDEX_NAME=rag-dev-local             # 개인 구분을 넣어(예: rag-dev-내이름) 서로의 인덱스를 덮어쓰지 않는다. 영문·숫자·_·-·. 만 쓴다
INDEX_WAIT_SECONDS=0                 # api 시작 시 인덱스(Qdrant)가 준비되길 기다리는 최대 초. 0이면 한 번만 확인 (compose 도 기본 0. Qdrant 가 늦게 뜨는 환경이면 늘린다)
MOCK_INDEX_DIR=./.mock_index           # APP_IMPL=mock 일 때만: 목업 인덱서가 manifest 를 저장하는 곳. 실제 구현은 쓰지 않는다
MOCK_INDEX_READY=0                   # APP_IMPL=mock 일 때만: 1이면 색인 없이도 데모 인덱스가 준비된 것으로 응답한다 (화면·API 시연용)
CORS_ALLOW_ORIGINS=                  # 브라우저(프론트 개발 서버)에서 api 를 직접 부를 출처. 쉼표로 구분 (예: http://localhost:5173). 비우면 CORS 를 켜지 않는다
RAG_MODEL_CACHE=./.model_cache       # 임베딩 모델 다운로드 위치

# --- 데이터 (저장소에 커밋하지 않는다). compose 의 cli 는 ./data 를 /data 로 마운트한다 ---
DOCUMENTS_DIR=./data/documents
EVALUATION_DIR=./data/evaluation
