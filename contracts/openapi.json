{
  "openapi": "3.1.0",
  "info": {
    "title": "RAG Q&A API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/query": {
      "post": {
        "summary": "Query",
        "operationId": "query_query_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "status=error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "status=error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "502": {
            "description": "status=error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "503": {
            "description": "status=error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "504": {
            "description": "status=error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/session/{session_id}": {
      "get": {
        "summary": "Session",
        "operationId": "session_session__session_id__get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$",
              "title": "Session Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "404": {
            "description": "session_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnswerStatus": {
        "type": "string",
        "enum": [
          "answered",
          "needs_clarification",
          "abstained",
          "error"
        ],
        "title": "AnswerStatus"
      },
      "ApiError": {
        "properties": {
          "error_code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error_code",
          "message"
        ],
        "title": "ApiError",
        "description": "QueryResponse가 아닌 오류 응답(현재는 /session 404)."
      },
      "Citation": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "book_id": {
            "type": "string",
            "title": "Book Id"
          },
          "file_name": {
            "type": "string",
            "title": "File Name"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "book_id",
          "file_name",
          "page"
        ],
        "title": "Citation"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "index_not_ready",
          "retrieval_failed",
          "model_timeout",
          "model_failed",
          "output_invalid",
          "ingest_failed",
          "invalid_input",
          "session_not_found",
          "internal"
        ],
        "title": "ErrorCode",
        "description": "status=error 일 때만 쓰는 오류 분류. 근거 부족(abstained)과 섞지 않는다."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "index_ready": {
            "type": "boolean",
            "title": "Index Ready"
          },
          "index_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Index Name"
          },
          "embedder_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Embedder Id"
          },
          "supported_modes": {
            "items": {
              "$ref": "#/components/schemas/RetrievalMode"
            },
            "type": "array",
            "title": "Supported Modes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "index_ready"
        ],
        "title": "HealthResponse"
      },
      "QueryMeta": {
        "properties": {
          "retrieval_mode": {
            "$ref": "#/components/schemas/RetrievalMode"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Tokens"
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Tokens"
          },
          "cost_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Usd"
          },
          "cache_hit": {
            "type": "boolean",
            "title": "Cache Hit",
            "default": false
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "retrieval_mode"
        ],
        "title": "QueryMeta"
      },
      "QueryRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "title": "Question"
          },
          "retrieval_mode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RetrievalMode"
              },
              {
                "type": "null"
              }
            ]
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{8,128}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "QueryRequest"
      },
      "QueryResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "status": {
            "$ref": "#/components/schemas/AnswerStatus"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "error_code": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              },
              {
                "type": "null"
              }
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/QueryMeta"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "status",
          "answer",
          "reason",
          "meta"
        ],
        "title": "QueryResponse"
      },
      "RetrievalMode": {
        "type": "string",
        "enum": [
          "naive",
          "hybrid",
          "hybrid_rerank"
        ],
        "title": "RetrievalMode",
        "description": "세 가지 필수 RAG 검색 방식."
      },
      "SessionInfo": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "last_active_at": {
            "type": "string",
            "format": "date-time",
            "title": "Last Active At"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "turn_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Turn Count"
          },
          "turns": {
            "items": {
              "$ref": "#/components/schemas/SessionTurn"
            },
            "type": "array",
            "title": "Turns"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "created_at",
          "last_active_at",
          "turn_count"
        ],
        "title": "SessionInfo",
        "description": "GET /session/{session_id} 응답."
      },
      "SessionTurn": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "asked_at": {
            "type": "string",
            "format": "date-time",
            "title": "Asked At"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "retrieval_mode": {
            "$ref": "#/components/schemas/RetrievalMode"
          },
          "status": {
            "$ref": "#/components/schemas/AnswerStatus"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "asked_at",
          "question",
          "retrieval_mode",
          "status",
          "answer"
        ],
        "title": "SessionTurn",
        "description": "세션에 기록된 질의응답 한 번. status=error 응답은 기록하지 않는다."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
